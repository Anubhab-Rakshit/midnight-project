# Preview network configuration
# Copy this file to .env.preview and fill in your wallet seed

# Use ONE of the following (not both):
# Option 1: 24-word BIP-39 mnemonic
# MIDNIGHT_PREVIEW_MNEMONIC=word1 word2 word3 ... word24

# Option 2: 64-character hex seed (no 0x prefix)
# MIDNIGHT_PREVIEW_SEED=abcd1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
